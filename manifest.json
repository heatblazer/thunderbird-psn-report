{
  "manifest_version": 2,
  "name": "PlayStation Spending Summary",
  "version": "0.1.0",
  "description": "Scans your mailbox for PlayStation Store receipts and totals what you spent.",
  "browser_specific_settings": {
    "gecko": {
      "id": "psn-spending-summary@example.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["accountsRead", "messagesRead", "clipboardWrite"],
  "browser_action": {
    "default_title": "PlayStation spending",
    "default_popup": "popup.html"
  }
}
